# 이 파일은 템플릿이다. 복사해서 .env 로 만들고 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 걸려 있다. **이 파일(.env.example)에는 실제 값을 적지 않는다.**

# KRX 데이터마켓플레이스 로그인 (수급/공매도/PER 전 기간 조회에 필요)
# data.krx.co.kr 자체 아이디/비밀번호. 소셜(네이버) 로그인 계정은 사용 불가.
KRX_ID=
KRX_PW=

# OpenDART 인증키 — https://opendart.fss.or.kr 에서 무료 발급 (40자 hex).
# 없으면 아래가 조용히 죽는다:
#   - 역사적 밸류에이션 밴드(PER/PBR/POR/ROE) -> "DART 재무 없음" 으로 표시
#   - 포워드 컨센서스의 시가총액 폴백(종가 × DART 발행주식수)
# 별칭도 인정된다: DART_API_KEY / OPENDART_KEY
OPENDART_API_KEY=

# KIS 폴백 (KRX 미설정 시 최근 30영업일 수급만 제공). 읽기전용 시세 조회만 사용.
KIS_APP_KEY=
KIS_APP_SECRET=
